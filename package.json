{
  "name": "wscore_email",
  "version": "0.1.0",
  "private": true,
  "description": "Módulo de infraestrutura de envio de e-mail (SMTP/AWS SES) compartilhado entre os módulos do WSCore",
  "main": "dist/Server/WSCore_Email.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch ./node_modules/ ./Server/WSCore_Email.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --build --clean && tsc --build",
    "start": "node dist/Server/WSCore_Email.js",
    "setup": "ts-node Server/Install.ts",
    "release": "standard-version",
    "release:first": "standard-version --first-release",
    "release:dry-run": "standard-version --dry-run",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "test": "node --require ts-node/register --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "mysql2": "^3.11.3",
    "nodemailer": "^10.6.1",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.6.0",
    "@types/nodemailer": "^8.0.2",
    "socket.io": "^4.8.1",
    "standard-version": "^9.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
